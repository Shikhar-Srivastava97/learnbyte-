PORT=5000
NODE_ENV=development

# Google AI Studio: get a key from https://aistudio.google.com/apikey
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=gemini-4-hydrogen
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Groq Cloud API Key (Free LPU Inference: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA Nemotron NIM API Key (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# MongoDB connection URI (Optional: Falls back to built-in reactive storage)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yjehk6z.mongodb.net/learnbyte?retryWrites=true&w=majority
